{
    "name": "state/walls",
    "description": "Statamic paywall addon for gated content and Stripe payments.",
    "license": "proprietary",
    "autoload": {
        "psr-4": {
            "State\\Walls\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WallsTests\\": "tests/"
        }
    },
    "extra": {
        "statamic": {
            "name": "Walls",
            "description": "Walls addon"
        },
        "laravel": {
            "providers": [
                "State\\Walls\\ServiceProvider"
            ]
        }
    },
    "require": {
        "php": "^8.2",
        "statamic/cms": "^5.0",
        "stripe/stripe-php": "^7.100"
    },
    "require-dev": {
        "orchestra/testbench": "^8.5 || ^9.0",
        "pestphp/pest": "^2.36 || ^3.0"
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "tw": "vendor/bin/pest --watch"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "pixelfear/composer-dist-plugin": true
        }
    }
}
